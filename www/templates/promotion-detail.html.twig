{% extends 'base-admin.html.twig' %}

{% block title %}CesiTonJob — {{ promotion.nom }}{% endblock %}

{% block styles %}
  <link rel="stylesheet" href="/public/css/liste.css">
{% endblock %}

{% block content %}
<main class="liste-page">
  <a href="/promotions" class="back-link"><i class="fa-solid fa-arrow-left"></i> Retour aux promotions</a>

  <div class="liste-header">
    <h1>{{ promotion.nom }}</h1>
    <span class="liste-count">{{ promotion.nb_etudiants }} étudiants</span>
  </div>

  <div class="promo-info">
    <span><i class="fa-solid fa-chalkboard-user"></i> Pilote : {{ promotion.pilote }}</span>
    <span><i class="fa-solid fa-calendar"></i> Année : {{ promotion.annee }}</span>
  </div>

  <div class="liste-search">
    <input type="text" placeholder="Rechercher un étudiant...">
  </div>

  <div class="table-wrapper">
    <table class="data-table">
      <thead>
        <tr>
          <th>Nom</th>
          <th>Prénom</th>
          <th>Email</th>
          <th>Candidatures</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        {% for etudiant in etudiants %}
          <tr>
            <td>{{ etudiant.nom }}</td>
            <td>{{ etudiant.prenom }}</td>
            <td>{{ etudiant.email }}</td>
            <td>{{ etudiant.nb_candidatures }}</td>
            <td class="table-actions">
              <a href="/etudiant/{{ etudiant.id }}/modifier" class="btn-edit"><i class="fa-solid fa-pen"></i></a>
              <button class="btn-delete" onclick="confirm('Supprimer cet étudiant ?')"><i class="fa-solid fa-trash"></i></button>
            </td>
          </tr>
        {% else %}
          <tr><td colspan="5">Aucun étudiant dans cette promotion.</td></tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
</main>
{% endblock %}
