{% extends 'base.html.twig' %}

{% block title %}CesiTonJob — Ma Wish-list{% endblock %}

{% block styles %}
  <link rel="stylesheet" href="/public/css/liste.css">
{% endblock %}

{% block content %}
<main class="liste-page wishlist-page">

  <div class="liste-header">
    <h1>Ma Wish-list
      {% if offres|length > 0 %}
        <span class="liste-count">{{ offres|length }}</span>
      {% endif %}
    </h1>
  </div>

  {% if offres|length > 0 %}
    <div class="cards-grid">
      {% for offre in offres %}
        <div class="card">
          <div class="card-header">
            <div class="card-logo-placeholder">{{ offre.entreprise|first }}</div>
            <div>
              <p class="card-title">{{ offre.titre }}</p>
              <p class="card-company">{{ offre.entreprise }}</p>
            </div>
          </div>
          <div class="card-badges">
            <span class="badge badge-blue">{{ offre.type == 'internship' ? 'Stage' : 'Alternance' }}</span>
            <span class="badge badge-gray">{{ offre.mode == 'on_site' ? 'Sur site' : (offre.mode == 'remote' ? 'Télétravail' : 'Hybride') }}</span>
            <span class="card-date">{{ offre.date }}</span>
          </div>
          <div class="card-meta">
            <div class="card-meta-row">
              <i class="fa-solid fa-location-dot"></i> {{ offre.ville }}
            </div>
            <div class="card-meta-row">
              <i class="fa-solid fa-euro-sign"></i> {{ offre.remuneration ?: 'Non précisée' }}
            </div>
          </div>
          {% if offre.competences is defined and offre.competences|length > 0 %}
            <div class="skill-tags">
              {% for competence in offre.competences %}
                <span class="skill-tag">{{ competence }}</span>
              {% endfor %}
            </div>
          {% endif %}
          <div class="card-footer">
            <a href="/wishlist/retirer/{{ offre.id }}"
               class="btn-bookmark active"
               title="Retirer de la wish-list">
              <i class="fa-solid fa-bookmark"></i>
            </a>
            <a href="/offre/{{ offre.id }}" class="btn-primary">
              Voir l'offre
            </a>
          </div>
        </div>
      {% endfor %}
    </div>

  {% else %}
    <div class="wishlist-empty">
      <div class="wishlist-empty-icon">
        <i class="fa-regular fa-bookmark"></i>
      </div>
      <p class="wishlist-empty-text">Votre wish-list est vide</p>
      <p class="wishlist-empty-sub">
        Sauvegardez des offres qui vous intéressent pour les retrouver facilement ici.
      </p>
      <a href="/offres" class="btn-primary">
        <i class="fa-solid fa-magnifying-glass"></i> Parcourir les offres
      </a>
    </div>
  {% endif %}

</main>
{% endblock %}
