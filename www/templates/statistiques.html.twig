{% extends 'base-admin.html.twig' %}

{% block title %}CesiTonJob — Statistiques{% endblock %}

{% block styles %}
  <link rel="stylesheet" href="../public/css/dashboard.css">
{% endblock %}

{% block content %}
<div class="stats-page">

  <div class="stats-header">
    <a href="/dashboard" class="back-link"><i class="fa-solid fa-arrow-left"></i> Dashboard</a>
    <h1>Statistiques des offres</h1>
  </div>

  {# ── Ligne KPI ── #}
  <div class="stats-kpi-row">

    <div class="stat-kpi-card">
      <div class="stat-kpi-icon"><i class="fa-solid fa-briefcase"></i></div>
      <div class="stat-kpi-body">
        <span class="stat-kpi-title">Offres disponibles</span>
        <span class="stat-kpi-value">{{ stats.total }}</span>
        <span class="stat-kpi-label">offres actives en base</span>
      </div>
    </div>

    <div class="stat-kpi-card">
      <div class="stat-kpi-icon"><i class="fa-solid fa-users"></i></div>
      <div class="stat-kpi-body">
        <span class="stat-kpi-title">Candidatures par offre</span>
        <span class="stat-kpi-value">{{ stats.moy_candidatures }}</span>
        <span class="stat-kpi-label">en moyenne par offre</span>
      </div>
    </div>

  </div>

  {# ── Ligne graphiques ── #}
  <div class="stats-bottom-row">

    {# Répartition par type #}
    <div class="stat-card">
      <p class="stat-card-title">
        <i class="fa-solid fa-chart-bar"></i>
        Répartition par type de contrat
      </p>
      {% set max_type = 1 %}
      {% for row in stats.par_type %}
        {% if row.total > max_type %}{% set max_type = row.total %}{% endif %}
      {% endfor %}
      <div class="type-bars">
        {% for row in stats.par_type %}
          <div class="type-bar">
            <div class="type-bar-header">
              <span class="type-bar-label">{{ row.type }}</span>
              <span class="type-bar-count">{{ row.total }}</span>
            </div>
            <div class="type-bar-track">
              <div class="type-bar-fill" style="width: {{ (row.total / max_type * 100)|round }}%"></div>
            </div>
          </div>
        {% else %}
          <p style="color:var(--color-text-muted);font-size:.85rem">Aucune donnée.</p>
        {% endfor %}
      </div>
    </div>

    {# Top wishlist #}
    <div class="stat-card">
      <p class="stat-card-title">
        <i class="fa-solid fa-bookmark"></i>
        Top 5 offres les plus wishlistées
      </p>
      <div class="wishlist-list">
        {% for offre in stats.top_wishlist %}
          <div class="wishlist-item">
            <span class="wishlist-item-rank">#{{ loop.index }}</span>
            <div class="wishlist-item-info">
              <a href="/offre/{{ offre.id }}" class="wishlist-item-title">{{ offre.titre }}</a>
              <p class="wishlist-item-company">{{ offre.entreprise }}</p>
            </div>
            <span class="wishlist-badge">
              <i class="fa-solid fa-heart"></i> {{ offre.nb_wishlist }}
            </span>
          </div>
        {% else %}
          <p style="color:var(--color-text-muted);font-size:.85rem">Aucune donnée.</p>
        {% endfor %}
      </div>
    </div>

  </div>

</div>
{% endblock %}
