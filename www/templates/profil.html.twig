{% extends 'base.html.twig' %}

{% block title %}CesiTonJob — Mon Profil{% endblock %}

{% block styles %}
  <link rel="stylesheet" href="/public/css/secondaires.css">
{% endblock %}

{% block content %}
<div class="page-content">
  <div class="content-block">
    <div class="profil-top">
      <div class="profil-avatar" style="width:80px;height:80px;border-radius:50%;background:var(--color-primary);color:#fff;display:flex;align-items:center;justify-content:center;font-size:1.5rem;font-weight:700;flex-shrink:0;">
        {{ user.prenom|first }}{{ user.nom|first }}
      </div>
      <div class="profil-identity">
        <p class="profil-nom">{{ user.prenom }} {{ user.nom }}</p>
        <span class="badge badge-blue">{{ user.role }}</span>
      </div>
    </div>

    <hr class="profil-divider">

    {% if session.user_role == 'admin' %}
    <form action="/profil" method="post" novalidate>
      <input type="hidden" name="_csrf_token" value="{{ csrf_token }}">
      <div class="form-group">
        <label for="prenom">Prénom</label>
        <input type="text" id="prenom" name="prenom" value="{{ user.prenom }}">
      </div>
      <div class="form-group">
        <label for="nom">Nom</label>
        <input type="text" id="nom" name="nom" value="{{ user.nom }}">
      </div>
      <div class="form-group">
        <label for="email">Adresse e-mail</label>
        <input type="email" id="email" name="email" value="{{ user.email }}">
      </div>
      <div class="form-actions">
        <button type="submit" class="btn-submit">Enregistrer les modifications</button>
      </div>
    </form>
    {% endif %}

    {% if session.user_role == 'etudiant' or session.user_role == 'pilote' %}
    <div class="form-group">
      <label for="prenom">Prénom</label>
      <input type="text" id="prenom" name="prenom" value="{{ user.prenom }}" disabled>
    </div>
    <div class="form-group">
      <label for="nom">Nom</label>
      <input type="text" id="nom" name="nom" value="{{ user.nom }}" disabled>
    </div>
    <div class="form-group">
      <label for="email">Adresse e-mail</label>
      <input type="email" id="email" name="email" value="{{ user.email }}" disabled>
    </div>
    {% endif %}
  </div>
</div>
{% endblock %}
