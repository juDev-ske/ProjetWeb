{% extends 'base.html.twig' %}

{% block title %}CesiTonJob — Contact{% endblock %}

{% block styles %}
  <link rel="stylesheet" href="/public/css/secondaires.css">
{% endblock %}

{% block content %}
<div class="page-content">
  <div class="two-col">
    <div class="two-col-left">
      <h1>Contactez-nous</h1>
      <p>Une question, une suggestion ou besoin d'aide ? Notre équipe est disponible pour vous répondre dans les meilleurs délais.</p>

      <div class="contact-items">
        <div class="contact-item">
          <div class="contact-icon"><i class="fa-solid fa-envelope"></i></div>
          <div>
            <p class="contact-label">Email</p>
            <p class="contact-value">contact@cesitonjob.fr</p>
          </div>
        </div>
        <div class="contact-item">
          <div class="contact-icon"><i class="fa-brands fa-linkedin"></i></div>
          <div>
            <p class="contact-label">LinkedIn</p>
            <p class="contact-value">CesiTonJob</p>
          </div>
        </div>
        <div class="contact-item">
          <div class="contact-icon"><i class="fa-solid fa-school"></i></div>
          <div>
            <p class="contact-label">École</p>
            <p class="contact-value">Groupe CESI</p>
          </div>
        </div>
      </div>
    </div>

    <div class="two-col-right">
      <div class="form-card">
        {% if success is defined and success %}
          <div style="text-align:center;padding:2rem 1rem;">
            <div style="font-size:2.5rem;margin-bottom:.75rem;color:var(--color-primary);">
              <i class="fa-solid fa-circle-check"></i>
            </div>
            <p style="font-size:1.1rem;font-weight:700;margin-bottom:.5rem;">Message envoy&eacute; !</p>
            <p style="font-size:.875rem;color:var(--color-text-muted);">Merci pour votre message. Notre &eacute;quipe vous r&eacute;pondra dans les meilleurs d&eacute;lais.</p>
            <a href="/contact" class="btn-primary" style="margin-top:1.25rem;display:inline-flex;">Envoyer un autre message</a>
          </div>
        {% else %}
        <p class="form-card-title">Envoyer un message</p>
        <form action="/contact" method="post">
          <div class="form-row">
            <div class="form-group">
              <label for="prenom">Prénom</label>
              <input type="text" id="prenom" name="prenom" placeholder="Jean" required minlength="2" maxlength="100">
            </div>
            <div class="form-group">
              <label for="nom">Nom</label>
              <input type="text" id="nom" name="nom" placeholder="Dupont" required minlength="2" maxlength="100">
            </div>
          </div>

          <div class="form-group">
            <label for="email">Adresse e-mail</label>
            <input type="email" id="email" name="email" placeholder="jean.dupont@cesi.fr" required maxlength="255">
          </div>

          <div class="form-group">
            <label for="sujet">Sujet</label>
            <select id="sujet" name="sujet">
              <option value="">Sélectionnez un sujet</option>
              <option value="question">Question générale</option>
              <option value="bug">Signaler un problème</option>
              <option value="suggestion">Suggestion</option>
              <option value="partenariat">Partenariat entreprise</option>
              <option value="autre">Autre</option>
            </select>
          </div>

          <div class="form-group">
            <label for="message">Message</label>
            <textarea id="message" name="message" rows="5" placeholder="Votre message..."></textarea>
          </div>

          <button type="submit" class="btn-submit">Envoyer le message</button>
        </form>
        {% endif %}
      </div>
    </div>
  </div>
</div>
{% endblock %}
