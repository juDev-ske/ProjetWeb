{% extends 'base.html.twig' %}

{% block title %}CesiTonJob — Trouvez votre stage{% endblock %}

{% block styles %}
  <link rel="stylesheet" href="/public/css/accueil.css">
{% endblock %}

{% block content %}

  <div class="hero-wrapper">
    <div class="hero">
      <div class="hero-text">Trouvez le stage ou l'alternance qui correspond à votre projet professionnel</div>
    </div>
  </div>

  <form class="search-bar" method="GET" action="/offres">
    <div class="search-field">
      <span class="search-field-label">QUOI ?</span>
      <input type="text" name="search" placeholder="Métier, entreprise, compétence...">
    </div>
    <div class="search-field">
      <span class="search-field-label">OÙ ?</span>
      <input type="text" name="ville" placeholder="Ville, département, code postal...">
    </div>
    <button type="submit" class="search-btn"><i class="fa-solid fa-magnifying-glass"></i></button>
  </form>

  <section class="section">
    <div class="section-title">
      <h2>Offres Tendances</h2>
      <a href="/offres"><i class="fa-solid fa-caret-right"></i></a>
    </div>
    <div class="cards-grid">
      {% for offre in offres %}
        <div class="card">
          <div class="card-header">
            <div class="card-logo-placeholder">{{ offre.entreprise|first }}</div>
            <div>
              <p class="card-title">{{ offre.titre }}</p>
              <p class="card-company">{{ offre.entreprise }}</p>
            </div>
          </div>
          <div class="card-badges">
            <span class="badge badge-blue">{{ offre.type == 'internship' ? 'Stage' : 'Alternance' }}</span>
            <span class="badge badge-gray">{{ offre.mode == 'on_site' ? 'Sur site' : (offre.mode == 'remote' ? 'Télétravail' : 'Hybride') }}</span>
            <span class="card-date">{{ offre.date }}</span>
          </div>
          <div class="card-meta">
            <div class="card-meta-row"><i class="fa-solid fa-location-dot"></i> {{ offre.ville }}</div>
            <div class="card-meta-row"><i class="fa-solid fa-euro-sign"></i> {{ offre.remuneration }}</div>
          </div>
          <div class="skill-tags">
            {% for competence in competences %}
              <span class="skill-tag">{{ competence }}</span>
            {% endfor %}
          </div>
          <div class="card-footer">
            <a href="/wishlist/ajouter/{{ offre.id }}" class="btn-bookmark" title="Sauvegarder">
              <i class="fa-regular fa-bookmark"></i>
            </a>
            <a href="/offre/{{ offre.id }}" class="btn-primary">Voir l'offre</a>
          </div>
        </div>
      {% else %}
        <p>Aucune offre disponible pour le moment.</p>
      {% endfor %}
    </div>
  </section>

{% endblock %}
