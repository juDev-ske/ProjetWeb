{% extends 'base.html.twig' %}

{% block title %}CesiTonJob — Créer une offre{% endblock %}

{% block styles %}
  <link rel="stylesheet" href="/public/css/secondaires.css">
{% endblock %}

{% block content %}
<div class="page-content">
  <div class="content-block" style="max-width:600px">
    <div class="form-page-header">
      <a href="/dashboard" class="back-link"><i class="fa-solid fa-arrow-left"></i> Retour</a>
      <h1>Créer une offre</h1>
    </div>

    {% include '_errors.html.twig' %}
    <form action="/creation-offre" method="post">
      <input type="hidden" name="_csrf_token" value="{{ csrf_token }}">
      <div class="form-group">
        <label for="title">Titre du poste</label>
        <input type="text" id="title" name="title" placeholder="Ex : Développeur Front-end" required minlength="3" maxlength="255">
      </div>

      <div class="form-group">
        <label for="company_id">Entreprise</label>
        <select id="company_id" name="company_id" required>
          <option value="">Sélectionnez une entreprise</option>
          {% for entreprise in entreprises %}
            <option value="{{ entreprise.id }}">{{ entreprise.nom }}</option>
          {% endfor %}
        </select>
      </div>

      <div class="form-group">
        <label for="description">Description du poste</label>
        <textarea id="description" name="description" rows="5" placeholder="Décrivez le poste, les missions..." maxlength="5000"></textarea>
      </div>

      <div class="form-group">
        <label for="type">Type de contrat</label>
        <select id="type" name="type" required>
          <option value="" selected disabled>Sélectionnez un type</option>
          <option value="internship">Stage</option>
          <option value="apprenticeship">Alternance</option>
        </select>
      </div>

      <div class="form-group">
        <label for="location_id">Localisation</label>
        <select id="location_id" name="location_id" required>
          <option value="">Sélectionnez une localisation</option>
          {% for location in locations %}
            <option value="{{ location.id }}">{{ location.nom }}</option>
          {% endfor %}
        </select>
      </div>

      <div class="form-group">
        <label>Compétences requises</label>
        <div class="skills-container" id="skills-container"
             data-all-skills="{{ skills|map(s => s.name)|json_encode }}"
             data-selected-skills="[]">
          <div class="skills-tags" id="skills-tags"></div>
          <div class="search-container">
            <input type="text" id="skills-input" placeholder="Ajouter un skill..." autocomplete="off">
            <div class="select-items" id="skills-options"></div>
          </div>
          <input type="hidden" name="skills" id="skills-hidden">
        </div>
      </div>

      {% block scripts %}
      <script src="/public/js/skills-picker.js"></script>
      {% endblock %}

      <div class="form-group">
        <label for="mode">Mode de travail</label>
        <select id="mode" name="mode" required>
          <option value="" selected disabled>Sélectionnez un mode</option>
          <option value="on_site">Sur site</option>
          <option value="remote">Télétravail</option>
          <option value="hybrid">Hybride</option>
        </select>
      </div>

      <div class="form-group">
        <label for="salary">Rémunération</label>
        <input type="text" id="salary" name="salary" placeholder="Ex : 600€/mois" maxlength="100">
      </div>

      <div class="form-actions">
        <a href="/dashboard" class="btn-cancel">Annuler</a>
        <button type="submit" class="btn-submit">Publier l'offre</button>
      </div>
    </form>
  </div>
</div>
{% endblock %}
