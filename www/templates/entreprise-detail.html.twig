{% extends 'base.html.twig' %}

{% block title %}CesiTonJob — {{ entreprise.nom }}{% endblock %}

{% block styles %}
  <link rel="stylesheet" href="/public/css/secondaires.css">
  <link rel="stylesheet" href="/public/css/liste.css">
{% endblock %}

{% block content %}
<div class="page-content">
  <div class="content-block">
    <div class="form-page-header">
      <a href="#" onclick="history.back(); return false;" class="back-link"><i class="fa-solid fa-arrow-left"></i> Retour</a>
      <h1>{{ entreprise.nom }}</h1>
    </div>

    <div class="detail-grid">
      {# ── Carte Informations ── #}
      <div class="detail-card">
        <h2>Informations</h2>
        <p><strong>Email :</strong> {{ entreprise.email ?: '—' }}</p>
        <p><strong>Téléphone :</strong> {{ entreprise.phone ?: '—' }}</p>
        <p><strong>Offres :</strong> {{ entreprise.nb_offres }}</p>
        <p><strong>Stagiaires ayant postulé :</strong> {{ entreprise.nb_stagiaires }}</p>
        <p class="detail-desc"><strong>Description :</strong><br>{{ entreprise.description ?: 'Aucune description.' }}</p>
      </div>

      {# ── Carte Évaluation ── #}
      <div class="detail-card">
        <h2>Évaluation</h2>

        {# Affichage de la note actuelle #}
        {% if entreprise.rating > 0 %}
          <div class="detail-rating-block">
            <span class="detail-rating-score">{{ entreprise.rating }}</span>
            <div class="detail-rating-right">
              <div class="detail-rating-stars">
                {% for i in 1..5 %}
                  {% if entreprise.rating >= i %}
                    <i class="fa-solid fa-star"></i>
                  {% elseif entreprise.rating >= i - 0.5 %}
                    <i class="fa-solid fa-star-half-stroke"></i>
                  {% else %}
                    <i class="fa-regular fa-star empty"></i>
                  {% endif %}
                {% endfor %}
              </div>
              <span class="detail-rating-label">Moyenne sur 5 ({{ entreprise.nb_evaluations }} avis)</span>
            </div>
          </div>
        {% else %}
          <div class="detail-rating-none">Pas encore évaluée</div>
        {% endif %}

        {# Formulaire avec demi-étoiles cliquables — JS driven (admin/pilote uniquement) #}
        {% if session.user_role in ['admin', 'pilote'] %}
        <form action="/entreprise/{{ entreprise.id }}/evaluer" method="post" class="detail-eval-form">
          <input type="hidden" name="_csrf_token" value="{{ csrf_token }}">
          <div class="star-picker-js" id="starPicker" data-value="{{ entreprise.rating }}">
            {% for i in 1..5 %}
              <span class="star-js" data-full="{{ i }}" data-half="{{ i - 0.5 }}">
                <i class="fa-regular fa-star"></i>
              </span>
            {% endfor %}
          </div>
          <input type="hidden" name="note" id="noteInput" value="{{ entreprise.rating }}">
          <p class="star-picker-label" id="starLabel">
            {% if entreprise.rating > 0 %}Note actuelle : {{ entreprise.rating }} / 5{% else %}Aucune note{% endif %}
          </p>
          <button type="submit" class="btn-submit">Évaluer</button>
        </form>
        {% endif %}

        {% if session.user_role == 'admin' or session.user_role == 'pilote' %}
        <div class="detail-actions">
          <a href="/entreprise/{{ entreprise.id }}/modifier" class="btn-submit">Modifier</a>
          <a href="/entreprise/{{ entreprise.id }}/supprimer" class="btn-danger">
            <i class="fa-solid fa-trash"></i> Supprimer
          </a>
        </div>
        {% endif %}
      </div>
    </div>

    <h2 class="detail-section-title">Offres de l'entreprise</h2>
    <div class="table-wrapper">
      <table class="data-table">
        <thead>
          <tr>
            <th>Titre</th><th>Type</th><th>Mode</th><th>Date</th><th>Candidatures</th><th>Statut</th>
          </tr>
        </thead>
        <tbody>
          {% for offre in offres %}
            <tr>
              <td><a href="/offre/{{ offre.id }}">{{ offre.titre }}</a></td>
              <td>{{ offre.type == 'internship' ? 'Stage' : 'Alternance' }}</td>
              <td>{{ offre.mode == 'on_site' ? 'Sur site' : (offre.mode == 'remote' ? 'Télétravail' : 'Hybride') }}</td>
              <td>{{ offre.date }}</td>
              <td>{{ offre.nb_candidatures }}</td>
              <td>
                <span class="badge {{ offre.is_active ? 'badge-green' : 'badge-gray' }}">
                  {{ offre.is_active ? 'Active' : 'Inactive' }}
                </span>
              </td>
            </tr>
          {% else %}
            <tr><td colspan="6">Aucune offre pour cette entreprise.</td></tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  </div>
</div>
{% endblock %}
{% block scripts %}
<script src="/public/js/star-picker.js"></script>
{% endblock %}
