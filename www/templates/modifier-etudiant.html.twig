{% extends 'base-admin.html.twig' %}

{% block title %}CesiTonJob — Modifier l'étudiant{% endblock %}

{% block styles %}
  <link rel="stylesheet" href="/public/css/secondaires.css">
{% endblock %}

{% block content %}
<div class="page-content">
  <div class="content-block" style="max-width:600px">
    <div class="form-page-header">
      <a href="/etudiants" class="back-link"><i class="fa-solid fa-arrow-left"></i> Retour</a>
      <h1>Modifier l'étudiant</h1>
    </div>

    <form action="/etudiant/{{ etudiant.id }}/modifier" method="post" novalidate>
      <div class="form-row">
        <div class="form-group">
          <label for="prenom">Prénom</label>
          <input type="text" id="prenom" name="prenom" value="{{ etudiant.first_name }}" required>
        </div>
        <div class="form-group">
          <label for="nom">Nom</label>
          <input type="text" id="nom" name="nom" value="{{ etudiant.last_name }}" required>
        </div>
      </div>

      <div class="form-group">
        <label for="email">Email</label>
        <input type="email" id="email" name="email" value="{{ etudiant.email }}">
      </div>

      <div class="form-group">
        <label for="stage_status">État de recherche de stage</label>
        <select id="stage_status" name="stage_status">
          <option value="searching"     {{ etudiant.stage_status == 'searching'     ? 'selected' : '' }}>En recherche</option>
          <option value="found"         {{ etudiant.stage_status == 'found'         ? 'selected' : '' }}>Stage trouvé</option>
          <option value="not_searching" {{ etudiant.stage_status == 'not_searching' ? 'selected' : '' }}>Pas en recherche</option>
        </select>
      </div>

      <div class="form-actions">
        <a href="/etudiants" class="btn-cancel">Annuler</a>
        <button type="submit" class="btn-submit">Enregistrer</button>
      </div>
    </form>
  </div>
</div>
{% endblock %}
