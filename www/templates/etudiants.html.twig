{% extends 'base-admin.html.twig' %}

{% block title %}CesiTonJob — Étudiants{% endblock %}

{% block styles %}
  <link rel="stylesheet" href="/public/css/liste.css">
{% endblock %}

{% block content %}
<main class="liste-page">
  <div class="liste-header">
    <h1>Étudiants</h1>
    <a href="/creation-etudiant" class="btn-add"><i class="fa-solid fa-plus"></i> Nouvel étudiant</a>
  </div>

  <form method="GET" action="/etudiants" class="liste-search">
    <input type="text" name="search" value="{{ search ?? '' }}" placeholder="Rechercher par nom, prénom, email...">
    <button type="submit" class="search-btn"><i class="fa-solid fa-magnifying-glass"></i></button>
  </form>

  <div class="table-wrapper">
    <table class="data-table">
      <thead>
        <tr>
          <th>Prénom</th>
          <th>Nom</th>
          <th>Email</th>
          <th>Candidatures</th>
          <th>État de stage</th>
          <th>Actif</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        {% for etudiant in etudiants %}
          {% set statut_label = {
            'searching':     'En recherche',
            'found':         'Stage trouvé',
            'not_searching': 'Pas en recherche'
          } %}
          {% set statut_color = {
            'searching':     '#f59e0b',
            'found':         '#10b981',
            'not_searching': '#94a3b8'
          } %}
          <tr>
            <td>{{ etudiant.prenom }}</td>
            <td>{{ etudiant.nom }}</td>
            <td>{{ etudiant.email }}</td>
            <td>{{ etudiant.nb_candidatures }}</td>
            <td>
              <span style="color:{{ statut_color[etudiant.stage_status] ?? '#94a3b8' }};font-weight:600;">
                {{ statut_label[etudiant.stage_status] ?? '—' }}
              </span>
            </td>
            <td>{{ etudiant.is_active ? 'Oui' : 'Non' }}</td>
            <td class="table-actions">
              <a href="/etudiant/{{ etudiant.id }}/modifier" class="btn-edit"><i class="fa-solid fa-pen"></i></a>
              <a href="/etudiant/{{ etudiant.id }}/supprimer" class="btn-delete"><i class="fa-solid fa-trash"></i></a>
            </td>
          </tr>
        {% else %}
          <tr><td colspan="7">Aucun étudiant enregistré.</td></tr>
        {% endfor %}
      </tbody>
    </table>
  </div>

  {% if pages > 1 %}
  <div class="pagination">
    {% for i in 1..pages %}
      <a href="/etudiants?page={{ i }}&search={{ search ?? '' }}"
         class="pagination-item {{ i == page_courante ? 'active' : '' }}">{{ i }}</a>
    {% endfor %}
  </div>
  {% endif %}
</main>
{% endblock %}
