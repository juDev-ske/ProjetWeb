{% extends 'base-admin.html.twig' %}

{% block title %}CesiTonJob — Créer un compte pilote{% endblock %}

{% block styles %}
  <link rel="stylesheet" href="/public/css/secondaires.css">
{% endblock %}

{% block content %}
<div class="page-content">
  <div class="content-block" style="max-width:600px">
    <div class="form-page-header">
      <a href="/dashboard" class="back-link"><i class="fa-solid fa-arrow-left"></i> Retour</a>
      <h1>Créer un compte pilote</h1>
    </div>

    <form action="/creation-pilote" method="post" novalidate>
      <div class="form-row">
        <div class="form-group">
          <label for="prenom">Prénom</label>
          <input type="text" id="prenom" name="prenom" placeholder="Marie" required>
        </div>
        <div class="form-group">
          <label for="nom">Nom</label>
          <input type="text" id="nom" name="nom" placeholder="Martin" required>
        </div>
      </div>

      <div class="form-group">
        <label for="email">Adresse e-mail</label>
        <input type="email" id="email" name="email" placeholder="m.martin@cesi.fr" required>
      </div>

      <div class="form-group">
        <label for="password">Mot de passe</label>
        <input type="password" id="password" name="password" placeholder="Mot de passe..." required>
      </div>

      <div class="form-actions">
        <a href="/dashboard" class="btn-cancel">Annuler</a>
        <button type="submit" class="btn-submit">Créer le compte pilote</button>
      </div>
    </form>
  </div>
</div>
{% endblock %}
