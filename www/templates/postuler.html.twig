{% extends 'base.html.twig' %}

{% block title %}CesiTonJob — Postuler{% endblock %}

{% block styles %}
  <link rel="stylesheet" href="/public/css/secondaires.css">
{% endblock %}

{% block content %}
<div class="page-content">
  <div class="content-block" style="max-width:680px">
    <div class="form-page-header">
      <a href="/offre/{{ offre.id }}" class="back-link"><i class="fa-solid fa-arrow-left"></i> Retour à l'offre</a>
      <h1>Postuler à l'offre</h1>
    </div>

    <div class="postuler-offre-resume">
      <div class="card-logo-placeholder">{{ offre.entreprise|first }}</div>
      <div>
        <p class="postuler-titre">{{ offre.titre }}</p>
        <p class="postuler-meta">{{ offre.entreprise }} · {{ offre.ville }} · {{ offre.type }}</p>
      </div>
    </div>

    <form action="/postuler/{{ offre.id }}" method="post" enctype="multipart/form-data" novalidate>

      <div class="form-group">
        <label>Curriculum Vitae (CV) <span style="color:#ef4444">*</span></label>
        <div class="file-upload">
          <input type="file" id="cv" name="cv" accept=".pdf,.doc,.docx" required>
          <label for="cv" class="file-upload-label">
            <i class="fa-solid fa-upload"></i>
            <span>Choisir un fichier PDF ou Word</span>
          </label>
        </div>
      </div>

      <div class="form-group">
        <label>Lettre de motivation (LM) <span style="color:#ef4444">*</span></label>
        <div class="file-upload">
          <input type="file" id="lm" name="lm" accept=".pdf,.doc,.docx" required>
          <label for="lm" class="file-upload-label">
            <i class="fa-solid fa-upload"></i>
            <span>Choisir un fichier PDF ou Word</span>
          </label>
        </div>
      </div>

      <div class="form-group">
        <label for="message">Message (optionnel)</label>
        <textarea id="message" name="message" rows="5" placeholder="Présentez-vous brièvement..."></textarea>
      </div>

      <div class="form-actions">
        <a href="/offre/{{ offre.id }}" class="btn-cancel">Annuler</a>
        <button type="submit" class="btn-submit">Envoyer ma candidature</button>
      </div>
    </form>
  </div>
</div>
{% endblock %}
