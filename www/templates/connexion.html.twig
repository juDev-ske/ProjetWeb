<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="icon" type="image/svg+xml" href="/public/images/logo-header.svg">
  <link rel="stylesheet" href="/public/css/layout.css">
  <link rel="stylesheet" href="/public/css/connexion.css">
  <style>
    .error-msg {
      background: #fee2e2;
      color: #b91c1c;
      border: 1px solid #fca5a5;
      border-radius: 8px;
      padding: 10px 14px;
      font-size: 0.875rem;
      margin-bottom: 12px;
    }
  </style>
  <script src="https://kit.fontawesome.com/bb09137a9a.js" crossorigin="anonymous"></script>
  <title>CesiTonJob — Se connecter</title>
</head>
<body>
  <main class="page">
    <section class="card">
      <a href="/" class="logo-link">
        <img class="logo" src="/public/images/logo-header.svg" alt="CesiTonJob">
      </a>
      <h1 class="title">Se connecter</h1>
      {% if error == '1' %}
        <p class="error-msg">Email ou mot de passe incorrect.</p>
      {% elseif error == '2' %}
        <p class="error-msg">Votre compte est désactivé.</p>
      {% endif %}
      <form class="login-form" action="/connexion" method="post" novalidate>
        <label>
          <span class="label-text">Adresse mail</span>
          <input type="email" name="email" placeholder="jean.dupont@cesi.fr" required autocomplete="email">
        </label>
        <label class="password-row">
          <span class="label-text">Mot de passe</span>
          <div class="pw-wrap">
            <input type="password" name="password" id="pw" placeholder="Mot de passe..." required>
            <button class="eye-btn" type="button" onclick="togglePw()" aria-label="Afficher">
              <svg id="eye" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8S1 12 1 12z"/></svg>
            </button>
          </div>
        </label>
        <div class="form-meta">
          <div class="toggle-row">
            <span class="toggle-label">Rester connecté·e</span>
            <label class="toggle" aria-label="Rester connecté">
              <input type="checkbox" name="remember">
              <span class="track"></span>
            </label>
          </div>
        </div>
        <button class="primary" type="submit">Je me connecte</button>
      </form>
    </section>
  </main>
  <script>
    let shownPw = false;
    function togglePw() {
      shownPw = !shownPw;
      const pw = document.getElementById('pw');
      const eye = document.getElementById('eye');
      pw.type = shownPw ? 'text' : 'password';
      eye.innerHTML = shownPw
        ? `<path d="M17.94 17.94A10 10 0 0 1 12 20c-7 0-11-8-11-8a18 18 0 0 1 5.06-5.94M9.9 4.24A9 9 0 0 1 12 4c7 0 11 8 11 8a18 18 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/>`
        : `<circle cx="12" cy="12" r="3"/><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8S1 12 1 12z"/>`;
    }
  </script>
</body>
</html>
