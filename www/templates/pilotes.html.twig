{% extends 'base.html.twig' %}

{% block title %}CesiTonJob — Pilotes{% endblock %}

{% block styles %}
  <link rel="stylesheet" href="/public/css/liste.css">
{% endblock %}

{% block content %}
<div class="liste-page">
  <div class="liste-header">
    <h1>Pilotes</h1>
    <a href="/creation-pilote" class="btn-add"><i class="fa-solid fa-plus"></i> Nouveau pilote</a>
  </div>

  <form method="GET" action="/pilotes" class="liste-search">
    <input type="text" name="search" value="{{ search ?? '' }}" placeholder="Rechercher par nom, prénom, email...">
    <button type="submit" class="search-btn"><i class="fa-solid fa-magnifying-glass"></i></button>
  </form>

  <div class="table-wrapper">
    <table class="data-table">
      <thead>
        <tr>
          <th>Prénom</th>
          <th>Nom</th>
          <th>Email</th>
          <th>Statut</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        {% for pilote in pilotes %}
          <tr>
            <td>{{ pilote.prenom }}</td>
            <td>{{ pilote.nom }}</td>
            <td>{{ pilote.email }}</td>
            <td>{{ pilote.is_active ? 'Actif' : 'Inactif' }}</td>
            <td class="table-actions">
              <a href="/pilote/{{ pilote.id }}/modifier" class="btn-edit"><i class="fa-solid fa-pen"></i></a>
              <a href="/pilote/{{ pilote.id }}/supprimer" class="btn-delete"><i class="fa-solid fa-trash"></i></a>
            </td>
          </tr>
        {% else %}
          <tr><td colspan="5">Aucun pilote enregistré.</td></tr>
        {% endfor %}
      </tbody>
    </table>
  </div>

  {% if pages > 1 %}
  <div class="pagination">
    {% for i in 1..pages %}
      <a href="/pilotes?page={{ i }}&search={{ search ?? '' }}"
         class="pagination-item {{ i == page_courante ? 'active' : '' }}">{{ i }}</a>
    {% endfor %}
  </div>
  {% endif %}
</div>
{% endblock %}
