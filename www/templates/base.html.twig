<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="icon" type="image/svg+xml" href="/public/images/logo-header.svg">
  <link rel="stylesheet" href="/public/css/layout.css">
  {% block styles %}{% endblock %}
  <script src="https://kit.fontawesome.com/bb09137a9a.js" crossorigin="anonymous"></script>
  <title>{% block title %}CesiTonJob{% endblock %}</title>
</head>
<body class="
  {% if session.user_role == 'pilote' %}theme-pilote
  {% elseif session.user_role == 'admin' %}theme-admin
  {% else %}theme-etudiant
  {% endif %}
">

  <header class="header">
    <nav class="nav">
      <a href="/" class="nav-logo">
        <img src="/public/images/logo-header.svg" alt="CesiTonJob">
        <span>CesiTonJob</span>
      </a>
      <ul class="nav-links">
        {% if session.user_role in ['admin', 'pilote'] %}
          <li><a href="/dashboard"           class="nav-item">Dashboard</a></li>
          <li><a href="/offres"              class="nav-item">Offres</a></li>
          <li><a href="/entreprises"         class="nav-item">Entreprises</a></li>
          <li><a href="/etudiants"           class="nav-item">Étudiants</a></li>
          {% if session.user_role == 'admin' %}
            <li><a href="/pilotes"           class="nav-item">Pilotes</a></li>
          {% endif %}
          <li><a href="/candidatures-pilote" class="nav-item">Candidatures</a></li>
          <li><a href="/statistiques"        class="nav-item">Statistiques</a></li>
        {% elseif session.user_role == 'etudiant' %}
          <li><a href="/offres" class="nav-item">Emploi</a></li>
          <li><a href="/candidature-spontanee" class="nav-item">Candidature Spontanée</a></li>
          <li><a href="/mes-candidatures" class="nav-item">Mes Candidatures</a></li>
          <li><a href="/wishlist" class="nav-item"><i class="fa-solid fa-bookmark"></i></a></li>
        {% else %}
          <li><a href="/offres" class="nav-item">Emploi</a></li>
        {% endif %}
      </ul>
      {% if session.user_id %}
        <a href="/profil" class="nav-btn">{{ session.user_name }}</a>
        <a href="/deconnexion" class="nav-btn" style="background:var(--color-text)">Déconnexion</a>
      {% else %}
        <a href="/connexion" class="nav-btn">Se connecter</a>
      {% endif %}
      <button class="nav-burger" id="navBurger" aria-label="Menu" aria-expanded="false">
        <i class="fa-solid fa-bars"></i>
      </button>
    </nav>
  </header>

  {# ── Menu mobile ── #}
  <div class="nav-mobile" id="navMobile">
    <div class="nav-mobile-backdrop" id="navMobileBackdrop"></div>
    <div class="nav-mobile-panel">
      <div class="nav-mobile-header">
        <a href="/" class="nav-mobile-logo">
          <img src="/public/images/logo-header.svg" alt="CesiTonJob">
          <span>CesiTonJob</span>
        </a>
        <button class="nav-mobile-close" id="navMobileClose" aria-label="Fermer">
          <i class="fa-solid fa-xmark"></i>
        </button>
      </div>
      <nav class="nav-mobile-links">
        {% if session.user_role in ['admin', 'pilote'] %}
          <a href="/dashboard"           class="nav-mobile-item"><i class="fa-solid fa-gauge"></i> Dashboard</a>
          <a href="/offres"              class="nav-mobile-item"><i class="fa-solid fa-briefcase"></i> Offres</a>
          <a href="/entreprises"         class="nav-mobile-item"><i class="fa-solid fa-building"></i> Entreprises</a>
          <a href="/etudiants"           class="nav-mobile-item"><i class="fa-solid fa-user-graduate"></i> Étudiants</a>
          {% if session.user_role == 'admin' %}
            <a href="/pilotes"           class="nav-mobile-item"><i class="fa-solid fa-chalkboard-user"></i> Pilotes</a>
          {% endif %}
          <a href="/candidatures-pilote" class="nav-mobile-item"><i class="fa-solid fa-folder-open"></i> Candidatures</a>
          <a href="/statistiques"        class="nav-mobile-item"><i class="fa-solid fa-chart-bar"></i> Statistiques</a>
        {% elseif session.user_role == 'etudiant' %}
          <a href="/offres"              class="nav-mobile-item"><i class="fa-solid fa-briefcase"></i> Emploi</a>
          <a href="/candidature-spontanee" class="nav-mobile-item"><i class="fa-solid fa-paper-plane"></i> Candidature Spontanée</a>
          <a href="/mes-candidatures"      class="nav-mobile-item"><i class="fa-solid fa-folder-open"></i> Mes Candidatures</a>
          <a href="/wishlist"              class="nav-mobile-item"><i class="fa-solid fa-bookmark"></i> Ma Wish-list</a>
        {% else %}
          <a href="/offres" class="nav-mobile-item"><i class="fa-solid fa-briefcase"></i> Emploi</a>
        {% endif %}
      </nav>
      <div class="nav-mobile-footer">
        {% if session.user_id %}
          <a href="/profil"      class="nav-btn">{{ session.user_name }}</a>
          <a href="/deconnexion" class="nav-btn" style="background:var(--color-text)">Déconnexion</a>
        {% else %}
          <a href="/connexion" class="nav-btn">Se connecter</a>
        {% endif %}
      </div>
    </div>
  </div>

  <main>
    {% block content %}{% endblock %}
  </main>

  <footer class="footer">
    <div class="footer-inner">
      <div class="footer-brand">
        <a href="/" class="footer-logo">
          <img src="/public/images/logo-header.svg" alt="CesiTonJob">
          <span>CesiTonJob</span>
        </a>
        <p class="footer-desc">La plateforme de stages et alternances pour les étudiants CESI.</p>
        <div class="footer-social">
          <a href="https://www.instagram.com/cesi_officiel/" target="_blank" aria-label="Instagram"><i class="fa-brands fa-instagram"></i></a>
          <a href="https://fr.linkedin.com/school/cesi-officiel/" target="_blank" aria-label="LinkedIn"><i class="fa-brands fa-linkedin"></i></a>
          <a href="https://x.com/GroupeCESI" target="_blank" aria-label="X"><i class="fa-brands fa-x-twitter"></i></a>
        </div>
      </div>
      <nav class="footer-nav">
        <p class="footer-nav-title">Liens</p>
        <a href="/a-propos">À propos</a>
        <a href="/contact">Contact</a>
        <a href="/mentions-legales">Mentions légales</a>
      </nav>
    </div>
    <div class="footer-bottom"><p>© 2026 CesiTonJob — Tous droits réservés</p></div>
  </footer>

  <script src="/public/js/main.js"></script>
  {% block scripts %}{% endblock %}
</body>
</html>
