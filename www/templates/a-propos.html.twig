{% extends 'base.html.twig' %}

{% block title %}CesiTonJob — À propos{% endblock %}

{% block styles %}
  <link rel="stylesheet" href="/public/css/secondaires.css">
{% endblock %}

{% block content %}
<div class="page-content">
  <div class="content-block">
    <div class="about-hero">
      <div class="about-hero-text">
        <h2>Qui sommes-nous ?</h2>
        <p>CesiTonJob est une plateforme de stages et d'alternances développée dans le cadre d'un projet etudiant à l'ecole d'ingénieur CESI.</p>
      </div>
      <div class="about-img-placeholder">
        <i class="fa-solid fa-users"></i>
      </div>
    </div>

    <h2>Notre équipe</h2>
    <div class="team-grid">
      {% for membre in equipe %}
        <div class="team-card">
          <div class="team-card-img" style="background:{{ membre.couleur }}">
            <i class="fa-solid fa-user"></i>
          </div>
          <div class="team-card-body">
            <p class="team-card-name">{{ membre.nom }}</p>
            <p class="team-card-desc">{{ membre.role }}</p>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</div>
{% endblock %}
