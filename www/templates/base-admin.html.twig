<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="icon" type="image/svg+xml" href="/public/images/logo-header.svg">
  <link rel="stylesheet" href="/public/css/layout.css">
  {% block styles %}{% endblock %}
  <script src="https://kit.fontawesome.com/bb09137a9a.js" crossorigin="anonymous"></script>
  <title>{% block title %}CesiTonJob — Admin{% endblock %}</title>
</head>
<body>

  <header class="header">
    <nav class="nav">
      <a href="/" class="nav-logo">
        <img src="/public/images/logo-header.svg" alt="CesiTonJob">
        <span>CesiTonJob</span>
      </a>
      <ul class="nav-links">
        <li><a href="/dashboard" class="nav-item">Dashboard</a></li>
        <li><a href="/offres" class="nav-item">Offres</a></li>
        <li><a href="/entreprises" class="nav-item">Entreprises</a></li>
        <li><a href="/etudiants" class="nav-item">Étudiants</a></li>
        {% if session.user_role == 'admin' %}
          <li><a href="/pilotes" class="nav-item">Pilotes</a></li>
        {% endif %}
        <li><a href="/candidatures-pilote" class="nav-item">Candidatures</a></li>
        <li><a href="/statistiques" class="nav-item">Statistiques</a></li>
      </ul>
      <a href="/profil" class="nav-btn">{{ session.user_name }}</a>
      <a href="/deconnexion" class="nav-btn" style="background:#ef4444">Déconnexion</a>
      <button class="nav-burger" aria-label="Menu"><i class="fa-solid fa-bars"></i></button>
    </nav>
  </header>

  <main>
    {% block content %}{% endblock %}
  </main>

  <footer class="footer">
    <div class="footer-inner">
      <div class="footer-brand">
        <a href="/" class="footer-logo">
          <img src="/public/images/logo-header.svg" alt="CesiTonJob">
          <span>CesiTonJob</span>
        </a>
        <p class="footer-desc">La plateforme de stages et alternances pour les étudiants CESI.</p>
        <div class="footer-social">
          <a href="#" aria-label="Instagram"><i class="fa-brands fa-instagram"></i></a>
          <a href="#" aria-label="LinkedIn"><i class="fa-brands fa-linkedin"></i></a>
          <a href="#" aria-label="X"><i class="fa-brands fa-x-twitter"></i></a>
        </div>
      </div>
      <nav class="footer-nav">
        <p class="footer-nav-title">Liens</p>
        <a href="/a-propos">À propos</a>
        <a href="/contact">Contact</a>
        <a href="/mentions-legales">Mentions légales</a>
      </nav>
    </div>
    <div class="footer-bottom"><p>© 2025 CesiTonJob — Tous droits réservés</p></div>
  </footer>

  {% block scripts %}{% endblock %}
</body>
</html>
