{% extends 'base.html.twig' %}

{% block title %}CesiTonJob — Offres de stage{% endblock %}

{% block styles %}
  <link rel="stylesheet" href="/public/css/offres.css">
{% endblock %}

{% block content %}
<div class="offres-page">

  <aside class="offres-sidebar">
    <button class="offres-filter-toggle" id="filterToggle" type="button" aria-expanded="false">
      <span><i class="fa-solid fa-sliders"></i> Filtres</span>
      <i class="fa-solid fa-chevron-down"></i>
    </button>

    <form method="GET" action="/offres" id="filter-form">
      <div class="offres-sidebar-body" id="filterBody">
        <div class="sidebar-title">
          <span>Filtres</span>
          <a href="/offres" class="sidebar-reset">Réinitialiser</a>
        </div>

        <div class="filter-group">
          <p class="filter-group-title">Type de contrat</p>
          {% set types = [
            {val: 'internship', label: 'Stage'},
            {val: 'apprenticeship', label: 'Alternance'}
          ] %}

          {% for t in types %}
            <label class="filter-option">
              <input type="checkbox" name="type[]" value="{{ t.val }}"
                {{ filters.type is defined and t.val in filters.type ? 'checked' : '' }}>
              {{ t.label }}
            </label>
          {% endfor %}
        </div>

        <div class="filter-group">
          <p class="filter-group-title">Localisation</p>
          <input
            type="text"
            class="filter-input"
            name="ville"
            value="{{ filters.ville ?? '' }}"
            placeholder="Ville, département...">
        </div>

        <div class="filter-group">
          <p class="filter-group-title">Mode</p>
          {% set modes = [
            {val: 'on_site', label: 'Sur site'},
            {val: 'remote', label: 'Télétravail'},
            {val: 'hybrid', label: 'Hybride'}
          ] %}

          {% for m in modes %}
            <label class="filter-option">
              <input type="checkbox" name="mode[]" value="{{ m.val }}"
                {{ filters.mode is defined and m.val in filters.mode ? 'checked' : '' }}>
              {{ m.label }}
            </label>
          {% endfor %}
        </div>

        <button type="submit" class="btn-submit" style="width:100%;margin-top:1rem">Appliquer</button>
      </div>
    </form>
  </aside>

  <div class="offres-main">
    <form method="GET" action="/offres">
      <div class="offres-search">
        <input
          type="text"
          name="search"
          value="{{ filters.search ?? '' }}"
          placeholder="Rechercher une offre...">
        <button type="submit" class="search-btn">
          <i class="fa-solid fa-magnifying-glass"></i>
        </button>
      </div>
    </form>

    <div class="offres-header">
      <p class="offres-count"><strong>{{ total }}</strong> offres trouvées</p>
    </div>

    <div class="offres-grid">
      {% for offre in offres %}
        {% set competences = offre.skill_names ? offre.skill_names|split('|') : [] %}
        <div class="card">
          <div class="card-header">
            <div class="card-logo-placeholder">{{ offre.entreprise|first }}</div>
            <div>
              <p class="card-title">{{ offre.titre }}</p>
              <p class="card-company">{{ offre.entreprise }}</p>
            </div>
          </div>

          <div class="card-badges">
            <span class="badge badge-blue">{{ offre.type }}</span>
            <span class="badge badge-gray">{{ offre.mode }}</span>
            <span class="card-date">{{ offre.date }}</span>
          </div>

          <div class="card-meta">
            <div class="card-meta-row"><i class="fa-solid fa-location-dot"></i> {{ offre.ville }}</div>
            <div class="card-meta-row"><i class="fa-solid fa-euro-sign"></i> {{ offre.remuneration }}</div>
          </div>

          <div class="skill-tags">
            {% for competence in competences %}
              <span class="skill-tag">{{ competence }}</span>
            {% endfor %}
          </div>

          <div class="card-footer">
            <a href="/wishlist/ajouter/{{ offre.id }}" class="btn-bookmark" title="Sauvegarder">
              <i class="fa-regular fa-bookmark"></i>
            </a>
            <a href="/offre/{{ offre.id }}" class="btn-primary">Voir l'offre</a>
          </div>
        </div>
      {% else %}
        <p>Aucune offre disponible pour le moment.</p>
      {% endfor %}
    </div>

    {% if pages > 1 %}
      <nav class="pagination">
        {% for i in 1..pages %}
          <a href="/offres?page={{ i }}&search={{ filters.search ?? '' }}"
             class="pagination-item {{ i == page_courante ? 'active' : '' }}">
            {{ i }}
          </a>
        {% endfor %}
      </nav>
    {% endif %}
  </div>

</div>
{% endblock %}