{% extends 'base.html.twig' %}

{% block title %}CesiTonJob — Candidature Spontanée{% endblock %}

{% block styles %}
  <link rel="stylesheet" href="/public/css/secondaires.css">
{% endblock %}

{% block content %}
<div class="page-content">
  <div class="two-col">
    <div class="two-col-left">
      <h1>Candidature Spontanée</h1>
      <p>Vous n'avez pas trouvé l'offre qui vous correspond ? Déposez votre candidature spontanée et faites-vous remarquer par les recruteurs.</p>

      <div class="feature-items">
        <div class="feature-item">
          <div class="feature-icon"><i class="fa-solid fa-file"></i></div>
          <div>
            <p class="feature-title">CV et lettre de motivation</p>
            <p class="feature-desc">Déposez vos documents pour présenter votre profil aux entreprises partenaires.</p>
          </div>
        </div>
        <div class="feature-item">
          <div class="feature-icon"><i class="fa-solid fa-magnifying-glass"></i></div>
          <div>
            <p class="feature-title">Visible par les recruteurs</p>
            <p class="feature-desc">Votre profil sera accessible aux recruteurs des entreprises partenaires CESI.</p>
          </div>
        </div>
        <div class="feature-item">
          <div class="feature-icon"><i class="fa-solid fa-bell"></i></div>
          <div>
            <p class="feature-title">Suivi de candidature</p>
            <p class="feature-desc">Suivez l'état de votre candidature depuis votre espace personnel.</p>
          </div>
        </div>
      </div>
    </div>

    <div class="two-col-right">
      <div class="form-card">
        <p class="form-card-title">Déposer ma candidature</p>
        <form action="/candidature-spontanee" method="post" novalidate>
          <div class="form-row">
            <div class="form-group">
              <label for="prenom">Prénom</label>
              <input type="text" id="prenom" name="prenom" placeholder="Jean" required>
            </div>
            <div class="form-group">
              <label for="nom">Nom</label>
              <input type="text" id="nom" name="nom" placeholder="Dupont" required>
            </div>
          </div>

          <div class="form-group">
            <label for="email">Adresse e-mail</label>
            <input type="email" id="email" name="email" placeholder="jean.dupont@cesi.fr" required>
          </div>

          <div class="form-group">
            <label for="entreprise">Entreprise ciblée</label>
            <input type="text" id="entreprise" name="entreprise" placeholder="Nom de l'entreprise">
          </div>

          <div class="form-group">
            <label for="poste">Poste visé</label>
            <input type="text" id="poste" name="poste" placeholder="Ex : Développeur Front-end">
          </div>

          <div class="form-group">
            <label for="contrat">Type de contrat</label>
            <select id="contrat" name="contrat">
              <option value="">Sélectionnez un type</option>
              <option value="stage">Stage</option>
              <option value="alternance">Alternance</option>
              <option value="cdi">CDI</option>
              <option value="cdd">CDD</option>
            </select>
          </div>

          <div class="form-group">
            <label for="message">Message</label>
            <textarea id="message" name="message" rows="4" placeholder="Présentez-vous et expliquez votre motivation..."></textarea>
          </div>

          <button type="submit" class="btn-submit">Envoyer ma candidature</button>
        </form>
      </div>
    </div>
  </div>
</div>
{% endblock %}
