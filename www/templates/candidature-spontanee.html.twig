{% extends 'base.html.twig' %}

{% block title %}CesiTonJob — Candidature Spontanée{% endblock %}

{% block styles %}
  <link rel="stylesheet" href="/public/css/secondaires.css">
{% endblock %}

{% block content %}
<div class="page-content">
  <div class="two-col">
    <div class="two-col-left">
      <h1>Candidature Spontanée</h1>
      <p>Vous n'avez pas trouvé l'offre qui vous correspond ? Déposez votre candidature spontanée et faites-vous remarquer par les recruteurs.</p>

      <div class="feature-items">
        <div class="feature-item">
          <div class="feature-icon"><i class="fa-solid fa-file"></i></div>
          <div>
            <p class="feature-title">CV et lettre de motivation</p>
            <p class="feature-desc">Déposez vos documents pour présenter votre profil aux entreprises partenaires.</p>
          </div>
        </div>
        <div class="feature-item">
          <div class="feature-icon"><i class="fa-solid fa-magnifying-glass"></i></div>
          <div>
            <p class="feature-title">Visible par les recruteurs</p>
            <p class="feature-desc">Votre profil sera accessible aux recruteurs des entreprises partenaires CESI.</p>
          </div>
        </div>
        <div class="feature-item">
          <div class="feature-icon"><i class="fa-solid fa-bell"></i></div>
          <div>
            <p class="feature-title">Suivi de candidature</p>
            <p class="feature-desc">Suivez l'état de votre candidature depuis votre espace personnel.</p>
          </div>
        </div>
      </div>
    </div>

    <div class="two-col-right">
      <div class="form-card">
        <p class="form-card-title">Déposer ma candidature</p>
        {% if success %}
          <div class="alert-success" style="background:#d1fae5;color:#065f46;padding:1rem;border-radius:8px;margin-bottom:1.5rem;text-align:center;">
            <i class="fa-solid fa-check-circle"></i> Votre candidature spontanée a bien été envoyée !
          </div>
        {% endif %}
        {% include '_errors.html.twig' %}
        <form action="/candidature-spontanee" method="post" enctype="multipart/form-data">
          <div class="form-row">
            <div class="form-group">
              <label for="prenom">Prénom</label>
              <input type="text" id="prenom" name="prenom" placeholder="Jean" required minlength="2" maxlength="100">
            </div>
            <div class="form-group">
              <label for="nom">Nom</label>
              <input type="text" id="nom" name="nom" placeholder="Dupont" required minlength="2" maxlength="100">
            </div>
          </div>

          <div class="form-group">
            <label for="email">Adresse e-mail</label>
            <input type="email" id="email" name="email" placeholder="jean.dupont@cesi.fr" required maxlength="255">
          </div>

          <div class="form-group">
            <label for="entreprise">Entreprise ciblée</label>
            <input type="text" id="entreprise" name="entreprise" placeholder="Nom de l'entreprise" maxlength="255">
          </div>

          <div class="form-group">
            <label for="poste">Poste visé</label>
            <input type="text" id="poste" name="poste" placeholder="Ex : Développeur Front-end" maxlength="255">
          </div>

          <div class="form-group">
            <label for="contrat">Type de contrat</label>
            <select id="contrat" name="contrat">
              <option value="">Sélectionnez un type</option>
              <option value="stage">Stage</option>
              <option value="alternance">Alternance</option>
              <option value="cdi">CDI</option>
              <option value="cdd">CDD</option>
            </select>
          </div>

          <div class="form-group">
            <label for="message">Message</label>
            <textarea id="message" name="message" rows="4" maxlength="2000" placeholder="Présentez-vous et expliquez votre motivation..."></textarea>
          </div>

          {# ── CV ── #}
          <div class="form-group">
            <label for="cv">Curriculum Vitae (CV) <span class="required-star">*</span></label>
            <div class="file-upload" id="cv-zone">
              <input type="file" id="cv" name="cv" accept=".pdf,.doc,.docx" required>
              <div class="file-upload-label">
                <i class="fa-solid fa-file-arrow-up"></i>
                <span id="cv-label">Choisir un fichier PDF ou Word</span>
                <small>PDF, DOC, DOCX · max 5 Mo</small>
              </div>
            </div>
          </div>

          {# ── LM ── #}
          <div class="form-group">
            <label for="lm">Lettre de motivation (LM)</label>
            <div class="file-upload" id="lm-zone">
              <input type="file" id="lm" name="lm" accept=".pdf,.doc,.docx">
              <div class="file-upload-label">
                <i class="fa-solid fa-file-arrow-up"></i>
                <span id="lm-label">Choisir un fichier PDF ou Word</span>
                <small>PDF, DOC, DOCX · max 5 Mo</small>
              </div>
            </div>
          </div>

          <button type="submit" class="btn-submit">Envoyer ma candidature</button>
        </form>
      </div>
    </div>
  </div>
</div>
{% endblock %}

{% block scripts %}
<script>
  [['cv', 'cv-zone', 'cv-label'], ['lm', 'lm-zone', 'lm-label']].forEach(([id, zone, lbl]) => {
    const input  = document.getElementById(id);
    const zoneEl = document.getElementById(zone);
    const lblEl  = document.getElementById(lbl);

    // Clic sur la zone → ouvre le sélecteur de fichier
    zoneEl.addEventListener('click', () => input.click());

    // Feedback nom de fichier
    input.addEventListener('change', function() {
      const file = this.files[0];
      if (file) {
        lblEl.textContent = file.name;
        zoneEl.classList.add('has-file');
      } else {
        lblEl.textContent = 'Choisir un fichier PDF ou Word';
        zoneEl.classList.remove('has-file');
      }
    });
  });
</script>
{% endblock %}
